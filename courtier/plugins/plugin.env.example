# 插件独立运行环境样例（plugin-owned env）
#
# 插件是独立 TCP 服务：由 scripts/dev-plugins.py（本地开发，自动加载本文件
# 同名 .env：plugins/plugin.env）或 docker-compose（生产，各自 environment
# 段）注入。主进程不再向插件注入任何变量——插件需要什么就在这里配什么。
# 未设置的变量回退到插件代码/依赖库的内置默认值。

# ========== 全部插件必需 ==========
# 与主进程共享的通道鉴权 token（必须与主进程 .env 的 COURTIER_PLUGIN_TOKEN 一致）
COURTIER_PLUGIN_TOKEN=change-me-plugin-token

# MinIO 受限账号（仅 transfer bucket，由 scripts/minio_plugin_io.py 创建）。
# 仅 parse/anydoc/annotate 等收发文件的插件真正使用，但建议统一配置。
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=courtier-plugins
MINIO_SECRET_KEY=change-me-plugin-minio-secret
MINIO_SECURE=false
# MINIO_BUCKET_PLUGIN_IO=courtier-plugin-io

# 可选：监听地址覆盖（默认读 plugin.yaml 的 runtime.port）与下载临时目录
# COURTIER_PLUGIN_LISTEN=0.0.0.0:9102
# COURTIER_PLUGIN_WORKDIR=/tmp

# ========== parse（格式解析，9101）==========
# 扫描件管线（OCR + 规则引擎结构识别）使用；DOCX/文本型 PDF 纯规则解析不依赖
# DOCPARSE_OCR_API_URL=http://127.0.0.1:8092/ocr
# DOCPARSE_OCR_LANG=ch
# DOCPARSE_OCR_ENGINE=ppstructure
# DOCPARSE_OCR_MAX_IMAGE_LONG_SIDE=2048
# DOCPARSE_OCR_DESKEW=            # 1/true 启用 OpenCV 纠偏（需 docparse[deskew]）
# DOCPARSE_MAX_OCR_CONCURRENT=10
# 字体识别模型（自训练 ResNet，可选；未配置则扫描页行无字体信息）
# FONT_MODEL_URL=http://127.0.0.1:5000
# FONT_MODEL_CONF_THRESHOLD=0.6
# FONT_MODEL_MARGIN_THRESHOLD=0.15

# ========== anydoc（文档转换，9102）==========
# 扫描件/图片 OCR 兜底端点（返回整页 Markdown）；未配置则扫描件报错提示改用 parse_layout
# ANYDOC_OCR_API_URL=http://127.0.0.1:8092/ocr/text

# ========== search（检索，9105）==========
# 纯 ES 检索原语：查询向量由主进程注入（host 端配置），LLM 重排在主进程侧执行
# ES_HOSTS=http://127.0.0.1:9200
# ES_USERNAME=elastic
# ES_PASSWORD=
# ES_INDEX_CHUNKS=courtier_chunks

# ========== annotate / template / check_format / check_content / detect_plagiarism ==========
# 无插件特有变量；annotate 的输出上传用上方的 MinIO 受限账号，
# template 经主进程反向 RPC 读模板库（无需 DB 凭据）。

# ========== media（媒体探测，9109）==========
# 上传的音频/视频经 ffprobe 探测真实格式/时长/分辨率；宿主需安装 ffmpeg，
# 或用 MEDIA_FFPROBE_PATH 指向 ffprobe 可执行文件。媒体上传 fail-closed：
# 插件不可达或探测失败时该类上传被拒绝。
# MEDIA_FFPROBE_PATH=/usr/bin/ffprobe
