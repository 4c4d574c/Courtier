# ========== 数据库 ==========
MYSQL_URL=mysql+asyncmy://root:123456@192.168.100.118:3366/doc_audit

# ========== 文件上传 ==========
UPLOAD_DIR=./uploads

# ========== LLM 通用配置（内容审核 content_checker 使用）==========
# LLM_IP=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_IP=http://192.168.100.67:8005/v1
LLM_IP=http://192.168.100.31:8008/v1
# LLM_IP=https://api.deepseek.com
# LLM_IP=http://localhost:11434/v1
# LLM_API_KEY=sk-8c5d25faf10e45468a001ff741d50cb8
# LLM_API_KEY=sk-9f6c06fb10764da3a4a7e66559510515
LLM_API_KEY=EMPTY
# LLM_NAME=glm-5.2
LLM_NAME=DeepSeek-V4-Flash
# LLM_NAME=Qwen3.6-35B-A3B
# LLM_NAME=Qwen3.6-27B
LLM_TEMPERATURE=0
# 单次 API 调用最大输出 token 数（含 reasoning_content），0=不限制
# 设置此值可防止模型陷入无限推理循环
LLM_MAX_TOKENS=10240
# 频率惩罚，减少模型重复相同 token（0.0-2.0），越高越不容易重复
LLM_FREQUENCY_PENALTY=0
# 存在惩罚，鼓励模型谈论新话题（0.0-2.0）
LLM_PRESENCE_PENALTY=0
# 透传给 API extra_body 的 JSON，用于控制模型特定参数
# 如 Qwen 模型: {"enable_thinking": false}
# LLM_EXTRA_BODY={"chat_template_kwargs": {"enable_thinking": false}}

# ========== 文档解析（docparse 使用）==========
DOCPARSE_OCR_API_URL=http://192.168.100.118:8006/ocr
DOCPARSE_OCR_LANG=ch
DOCPARSE_OCR_ENGINE=ppstructure
DOCPARSE_OCR_MAX_IMAGE_LONG_SIDE=2048
# auto,rule_only,llm_only
DOCPARSE_CLASSIFY_MODE=rule_only

# ========== 通用纠错（doccorrector 使用）==========
CEC_API_BASE=http://192.168.100.118:9090/v1
CEC_API_KEY=gpustack_fff96d1ac01f756d_cb64ce3ec15f3bfb555b3e3e2b290f43
CEC_MODEL_NAME=ChineseErrorCorrector3-4B
CEC_MAX_LENGTH=16383
# 用户保护词典路径（禁止纠错的词表），留空则不加载
CEC_USER_DICT=./src/doccorrector/user_dict.txt
# 合法叠词，多个字用逗号分隔，被这些词不会被标记为重复字错误
CEC_ALLOWED_PATTERNS=看一看,想一想,试一试,人人,一一

# ========== MinIO ==========
MINIO_ENDPOINT=192.168.100.118:9000
MINIO_ACCESS_KEY=root
MINIO_SECRET_KEY=12345678
MINIO_SECURE=false
MINIO_BUCKET_RESOURCES=courtier-resources
MINIO_BUCKET_DOCUMENTS=courtier-documents
MINIO_BUCKET_DOCS=courtier-docs
MINIO_BUCKET_LIBRARY=courtier-library

# ========== Elasticsearch ==========
# ES_HOSTS=http://localhost:9200
ES_HOSTS=http://192.168.100.118:9200
ES_USERNAME=elastic
ES_PASSWORD=es_admin
ES_INDEX_CHUNKS=courtier_chunks

# ========== Gateway Agent ==========
GATEWAY_AGENT_BASE_URL=
GATEWAY_AGENT_ID=

# ========== 缓存 ==========
CACHE_DIR=./uploads/.cache

# ========== 日志 ==========
LOGGER_LEVEL=INFO

# ========== 审计日志（记录 LLM prompts、reasoning、工具调用等）==========
AUDIT_LOG_ENABLED=true
AUDIT_LOG_DIR=./.agent_logs

# ========== Agent 循环守卫 ==========
# 连续无业务产出轮次上限，超过则强制终止
LOOP_MAX_TURNS_WITHOUT_BUSINESS_ARTIFACTS=999
# 推理步骤去重检测窗口大小
LOOP_MAX_REASONING_DUPE_STEPS=3
# 推理步骤相似度阈值（0.0-1.0），超过视为重复
LOOP_REASONING_SIMILARITY_THRESHOLD=0.85
# 连续空工具结果上限，超过则强制终止
LOOP_MAX_NULL_TOOL_RESULTS=5
# 重复相同工具调用上限，超过则强制终止
LOOP_MAX_SAME_TOOL_CALLS=3
# 连续探索性工具调用上限，超过则强制终止
LOOP_MAX_CONSECUTIVE_EXPLORATORY=8

# ========== 子代理运行时预算 ==========
# 单个子代理最大挂钟时间（秒），0=不限时
SUBAGENT_MAX_RUNTIME_SECONDS=1200
# 同一根节点下所有子代理累计最大运行时间（秒）
SUBAGENT_MAX_CUMULATIVE_RUNTIME_SECONDS=3600
# 单个子代理最大思考轮数
SUBAGENT_MAX_TURNS=20
# 子代理最大嵌套深度
SUBAGENT_MAX_DEPTH=5
# 最大子代理派生总数
SUBAGENT_MAX_TOTAL_SPAWNS=20

# === 可观测性 ===
DEPLOYMENT_ENVIRONMENT=production
JWT_SECRET=dev-jwt-secret-change-in-production
ADMIN_PASSWORD=dev-admin-password-change-in-production
OTEL_SERVICE_NAME=courtier
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
OTEL_TRACES_SAMPLER=always_on
OTEL_METRICS_EXPORTER=otlp
OTEL_LOG_LEVEL=INFO
