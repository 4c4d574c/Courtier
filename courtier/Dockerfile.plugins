FROM plugin-base AS plugin-template
COPY plugins/shared/template/ plugins/shared/template/
WORKDIR /opt/courtier/plugins/shared/template
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --no-dev --no-editable
