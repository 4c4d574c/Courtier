# ---- shared plugins ------------------------------------------------------

FROM plugin-base AS plugin-anydoc
COPY plugins/shared/anydoc/ plugins/shared/anydoc/
WORKDIR /opt/courtier/plugins/shared/anydoc
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --no-dev --no-editable
RUN chown -R courtier:courtier /opt/courtier
USER courtier
EXPOSE 9102
CMD ["/opt/courtier/plugins/shared/anydoc/.venv/bin/python", "entry.py"]

FROM plugin-base AS plugin-annotate
COPY plugins/shared/annotate/ plugins/shared/annotate/
WORKDIR /opt/courtier/plugins/shared/annotate
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --no-dev --no-editable
RUN chown -R courtier:courtier /opt/courtier
