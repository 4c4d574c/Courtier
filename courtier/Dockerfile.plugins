EXPOSE 9107
CMD ["/opt/courtier/plugins/docaudit/audit/check_content/.venv/bin/python", "entry.py"]

FROM plugin-base AS plugin-detect_plagiarism
COPY plugins/docaudit/audit/detect_plagiarism/ plugins/docaudit/audit/detect_plagiarism/
WORKDIR /opt/courtier/plugins/docaudit/audit/detect_plagiarism
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --no-dev --no-editable
RUN chown -R courtier:courtier /opt/courtier
USER courtier
EXPOSE 9108
