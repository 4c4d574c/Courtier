# Standalone plugin images — one build target per plugin.
#
# Plugins are independent TCP servers; the app dials them via
# COURTIER_PLUGIN_ENDPOINTS.  Each target installs the plugin's own
# dependency set (uv sync with its lockfile) so plugin environments are
# reproducible and isolated from the app image.
#
# Build all:   docker compose build
# Build one:   docker build -f Dockerfile.plugins --target plugin-anydoc .
#
# Layout note: plugin pyprojects reference libs/ via relative paths
# ([tool.uv.sources]), so the build context must keep the repo layout
# (libs/ and plugins/ side by side) — the context is the courtier/ dir.

FROM python:3.12-slim AS plugin-base

# Pinned: floating latest on the production runtime path risks supply-chain drift.
COPY --from=ghcr.io/astral-sh/uv:0.11.4 /uv /usr/local/bin/uv

ENV PYTHONUNBUFFERED=1 \
    UV_NO_SYNC=1

WORKDIR /opt/courtier

# Plugins parse untrusted documents — never run them as root.
RUN groupadd --gid 1000 courtier \
    && useradd --uid 1000 --gid courtier --create-home courtier

# Shared by every plugin's [tool.uv.sources] relative paths.
COPY libs/ libs/


# ---- docaudit domain plugins --------------------------------------------

FROM plugin-base AS plugin-parse
COPY plugins/docaudit/parse/ plugins/docaudit/parse/
WORKDIR /opt/courtier/plugins/docaudit/parse
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --no-dev --no-editable
RUN chown -R courtier:courtier /opt/courtier
USER courtier
EXPOSE 9101
CMD ["/opt/courtier/plugins/docaudit/parse/.venv/bin/python", "entry.py"]

FROM plugin-base AS plugin-check_format
COPY plugins/docaudit/audit/check_format/ plugins/docaudit/audit/check_format/
WORKDIR /opt/courtier/plugins/docaudit/audit/check_format
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --no-dev --no-editable
RUN chown -R courtier:courtier /opt/courtier
USER courtier
EXPOSE 9106
CMD ["/opt/courtier/plugins/docaudit/audit/check_format/.venv/bin/python", "entry.py"]

FROM plugin-base AS plugin-check_content
COPY plugins/docaudit/audit/check_content/ plugins/docaudit/audit/check_content/
WORKDIR /opt/courtier/plugins/docaudit/audit/check_content
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --no-dev --no-editable
RUN chown -R courtier:courtier /opt/courtier
